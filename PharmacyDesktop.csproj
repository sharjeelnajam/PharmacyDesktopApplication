<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PharmaDesk</AssemblyName>
    <RootNamespace>PharmacyDesktop</RootNamespace>
    <Product>PharmaDesk</Product>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <NoWarn>$(NoWarn);CS8618;CS8622;WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Single-file, self-contained release build: dotnet publish -c Release -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <!-- Use the private, git-ignored owner secrets when present; otherwise the placeholder. -->
  <ItemGroup Condition="Exists('Core\OwnerSecrets.cs')">
    <Compile Remove="Core\OwnerSecrets.Default.cs" />
  </ItemGroup>
  <Target Name="WarnPlaceholderSecrets" BeforeTargets="Build" Condition="!Exists('Core\OwnerSecrets.cs')">
    <Warning Text="Core\OwnerSecrets.cs not found — building with placeholder secrets; owner sign-in is disabled." />
  </Target>

</Project>
